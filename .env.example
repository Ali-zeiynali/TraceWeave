# TraceWeave v0.5 — copy to .env. Empty values are ignored.
# Up to three credentials/provider are accepted. Keys remain in environment only;
# router health/model catalogs store credential IDs, never raw tokens.

TRACEWEAVE_DATA_DIR=.traceweave
TRACEWEAVE_SEARCH_BACKEND=auto
TRACEWEAVE_SEARXNG_URL=http://127.0.0.1:8080
TRACEWEAVE_SEARCH_TIMEOUT_SECONDS=20

# ----- Generic web / traversal -----
TRACEWEAVE_FETCH_TIMEOUT_SECONDS=20
TRACEWEAVE_FETCH_MAX_BYTES=3000000
TRACEWEAVE_FETCH_CONCURRENCY=4
TRACEWEAVE_USER_AGENT=TraceWeave/0.5
TRACEWEAVE_RESPECT_ROBOTS=true
TRACEWEAVE_FRONTIER_ENABLED=true
TRACEWEAVE_FRONTIER_MIN_SCORE=0.16
TRACEWEAVE_FRONTIER_PER_DOMAIN_LIMIT=8
TRACEWEAVE_SITEMAP_ENABLED=true
TRACEWEAVE_BROWSER_FALLBACK=false
TRACEWEAVE_BROWSER_MIN_TEXT_CHARS=500

# ----- Evidence -----
TRACEWEAVE_TRIAGE_ENABLED=true
TRACEWEAVE_CLAIMS_ENABLED=true
TRACEWEAVE_CLAIMS_MAX_SOURCES_PER_ROUND=8
TRACEWEAVE_CLAIM_MIN_RELEVANCE=55

# ----- Stage 4 specialist sources -----
TRACEWEAVE_ARCHIVES_ENABLED=true
TRACEWEAVE_WAYBACK_ENABLED=true
TRACEWEAVE_COMMONCRAWL_ENABLED=true
TRACEWEAVE_ACADEMIC_ENABLED=true
TRACEWEAVE_GITHUB_ENABLED=true
TRACEWEAVE_PDF_ENABLED=true
TRACEWEAVE_SPECIALIST_QUERIES_PER_ROUND=3
TRACEWEAVE_SPECIALIST_RESULTS_PER_QUERY=5
TRACEWEAVE_ARCHIVE_SOURCES_PER_ROUND=4
TRACEWEAVE_ARCHIVE_CAPTURES_PER_SOURCE=3
TRACEWEAVE_PDF_MAX_BYTES=20000000
# Optional, raises GitHub public API limits:
TRACEWEAVE_GITHUB_TOKEN=
# Optional polite pool identity for OpenAlex/Crossref:
TRACEWEAVE_OPENALEX_MAILTO=

# ----- Stage 5 graph foundation -----
TRACEWEAVE_ENTITY_GRAPH_ENABLED=true

# ----- Model router -----
TRACEWEAVE_PROVIDER_CONFIG=providers.toml
TRACEWEAVE_LLM_TIMEOUT_SECONDS=75
TRACEWEAVE_LLM_TEMPERATURE=0.15
TRACEWEAVE_ROUTER_MAX_ATTEMPTS=8
TRACEWEAVE_ROUTER_HEALTH_TTL_SECONDS=900
TRACEWEAVE_PROVIDER_CATALOG_TTL_SECONDS=21600
TRACEWEAVE_PROVIDER_CATALOG_AUTO_SYNC=true

# Built-in providers: set only the keys you have. KEY or KEY_1 = token-1; then _2, _3.
AGENTROUTER_API_KEY=
AGENTROUTER_API_KEY_2=
AGENTROUTER_API_KEY_3=
# AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1

SEEKROUTER_API_KEY=
SEEKROUTER_API_KEY_2=
SEEKROUTER_API_KEY_3=
# SeekRouter currently documents HTTP. Override this if your account/provider exposes HTTPS.
# SEEKROUTER_BASE_URL=http://www.seekrouter.com/api/v1

ZENMUX_API_KEY=
ZENMUX_API_KEY_2=
ZENMUX_API_KEY_3=
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional legacy single OpenAI-compatible endpoint, used only if no mesh route exists.
TRACEWEAVE_API_BASE=
TRACEWEAVE_API_KEY=
TRACEWEAVE_MODEL=

# ----- Local TUI shell -----
# User-triggered only; TraceWeave never grants it to fetched web content/models.
TRACEWEAVE_SHELL_ENABLED=false
TRACEWEAVE_SHELL_TIMEOUT_SECONDS=30
TRACEWEAVE_SHELL_MAX_OUTPUT_CHARS=20000
