# TraceWeave v1.0.2 — copy to .env. Empty values are ignored.
# Up to five credentials/provider are accepted (Cloudflare account pairs: three). Keys remain in environment only;
# router health/model catalogs store credential IDs, never raw tokens.

TRACEWEAVE_DATA_DIR=.traceweave
TRACEWEAVE_SEARCH_BACKEND=auto
TRACEWEAVE_SEARXNG_URL=http://127.0.0.1:8080
TRACEWEAVE_SEARCH_TIMEOUT_SECONDS=20

# ----- Generic web / traversal -----
TRACEWEAVE_FETCH_TIMEOUT_SECONDS=20
TRACEWEAVE_FETCH_MAX_BYTES=3000000
TRACEWEAVE_FETCH_CONCURRENCY=4
TRACEWEAVE_USER_AGENT=TraceWeave/0.5
TRACEWEAVE_RESPECT_ROBOTS=true
TRACEWEAVE_FRONTIER_ENABLED=true
TRACEWEAVE_FRONTIER_MIN_SCORE=0.16
TRACEWEAVE_FRONTIER_PER_DOMAIN_LIMIT=8
TRACEWEAVE_SITEMAP_ENABLED=true
TRACEWEAVE_BROWSER_FALLBACK=false
TRACEWEAVE_BROWSER_BACKEND=auto
TRACEWEAVE_BROWSER_MIN_TEXT_CHARS=500
TRACEWEAVE_FETCH_PER_HOST_DELAY_SECONDS=0.75
TRACEWEAVE_FETCH_RETRIES=2

# ----- Evidence -----
TRACEWEAVE_TRIAGE_ENABLED=true
TRACEWEAVE_CLAIMS_ENABLED=true
TRACEWEAVE_CLAIMS_MAX_SOURCES_PER_ROUND=8
TRACEWEAVE_CLAIM_MIN_RELEVANCE=55

# ----- Stage 4 specialist sources -----
TRACEWEAVE_ARCHIVES_ENABLED=true
TRACEWEAVE_RESEARCH_QUERY_CONCURRENCY=3
TRACEWEAVE_WAYBACK_ENABLED=true
TRACEWEAVE_COMMONCRAWL_ENABLED=true
TRACEWEAVE_ACADEMIC_ENABLED=true
TRACEWEAVE_GITHUB_ENABLED=true
TRACEWEAVE_PDF_ENABLED=true
TRACEWEAVE_REGISTRY_SOURCES_ENABLED=true
TRACEWEAVE_REGISTRY_QUERIES_PER_ROUND=1
TRACEWEAVE_CERTIFICATE_TRANSPARENCY_ENABLED=true
TRACEWEAVE_URLSCAN_ENABLED=true
TRACEWEAVE_SEC_EDGAR_ENABLED=true
TRACEWEAVE_PEERINGDB_ENABLED=true
TRACEWEAVE_COMPANIES_HOUSE_ENABLED=true
TRACEWEAVE_PUBLIC_SOCIAL_ENABLED=true
TRACEWEAVE_BLUESKY_ENABLED=true
TRACEWEAVE_TELEGRAM_PUBLIC_ENABLED=false
TRACEWEAVE_SOCIAL_QUERIES_PER_ROUND=1
TRACEWEAVE_MEDIA_ENABLED=true
TRACEWEAVE_MEDIA_SOURCES_PER_ROUND=6
TRACEWEAVE_MEDIA_ASSETS_PER_SOURCE=4
TRACEWEAVE_MEDIA_MAX_BYTES=8000000
TRACEWEAVE_REMOTE_VISION_ENABLED=false
TRACEWEAVE_SPECIALIST_QUERIES_PER_ROUND=3
TRACEWEAVE_SPECIALIST_RESULTS_PER_QUERY=5
TRACEWEAVE_ARCHIVE_SOURCES_PER_ROUND=4
TRACEWEAVE_ARCHIVE_CAPTURES_PER_SOURCE=3
TRACEWEAVE_PDF_MAX_BYTES=20000000
# Optional, raises GitHub public API limits:
TRACEWEAVE_GITHUB_TOKEN=
# Optional polite pool identity for OpenAlex/Crossref:
TRACEWEAVE_OPENALEX_MAILTO=

# ----- Stage 5 graph foundation -----
TRACEWEAVE_ENTITY_GRAPH_ENABLED=true

# ----- Model router -----
TRACEWEAVE_PROVIDER_CONFIG=providers.toml
TRACEWEAVE_LLM_TIMEOUT_SECONDS=75
TRACEWEAVE_LLM_TEMPERATURE=0.15
TRACEWEAVE_ROUTER_MAX_ATTEMPTS=8
TRACEWEAVE_ROUTER_HEALTH_TTL_SECONDS=900
TRACEWEAVE_PROVIDER_CATALOG_TTL_SECONDS=21600
TRACEWEAVE_PROVIDER_CATALOG_AUTO_SYNC=true
# Hard route filter: models not explicitly marked free/free-tier eligible are ignored.
TRACEWEAVE_ZERO_COST_ONLY=true

# Built-in providers: set only the keys you have. KEY or KEY_1 = token-1; then _2 through _5.
AGENTROUTER_API_KEY=
AGENTROUTER_API_KEY_2=
AGENTROUTER_API_KEY_3=
AGENTROUTER_API_KEY_4=
AGENTROUTER_API_KEY_5=
# AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1

SEEKROUTER_API_KEY=
SEEKROUTER_API_KEY_2=
SEEKROUTER_API_KEY_3=
SEEKROUTER_API_KEY_4=
SEEKROUTER_API_KEY_5=
# SeekRouter currently documents HTTP. Override this if your account/provider exposes HTTPS.
# SEEKROUTER_BASE_URL=http://www.seekrouter.com/api/v1

ZENMUX_API_KEY=
ZENMUX_API_KEY_2=
ZENMUX_API_KEY_3=
ZENMUX_API_KEY_4=
ZENMUX_API_KEY_5=
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_API_KEY_4=
MISTRAL_API_KEY_5=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

SAMBANOVA_API_KEY=
SAMBANOVA_API_KEY_2=
SAMBANOVA_API_KEY_3=
SAMBANOVA_API_KEY_4=
SAMBANOVA_API_KEY_5=
# SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# Cloudflare Workers AI requires both values. Only @cf/* models are preset;
# third-party AI Gateway routes can be billable and are intentionally excluded.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY_2=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_KEY_3=
CLOUDFLARE_ACCOUNT_ID_3=

# NVIDIA hosted NIM. If only one of generic/text/vision is set it is reused for both roles.
NVIDIA_API_KEY=
NVIDIA_TEXT_API_KEY=
NVIDIA_TEXT_API_KEY_2=
NVIDIA_TEXT_API_KEY_3=
NVIDIA_TEXT_API_KEY_4=
NVIDIA_TEXT_API_KEY_5=
NVIDIA_VISION_API_KEY=
NVIDIA_VISION_API_KEY_2=
NVIDIA_VISION_API_KEY_3=
NVIDIA_VISION_API_KEY_4=
NVIDIA_VISION_API_KEY_5=
NARAROUTER_API_KEY=
NARAROUTER_API_KEY_2=
NARAROUTER_API_KEY_3=
NARAROUTER_API_KEY_4=
NARAROUTER_API_KEY_5=
# AIGATEAPI_KEY is also accepted for compatibility with existing setups.
AIGATE_API_KEY=
AIGATE_API_KEY_2=
AIGATE_API_KEY_3=
AIGATE_API_KEY_4=
AIGATE_API_KEY_5=

# ----- Optional passive data APIs / official public social sessions -----
URLSCAN_API_KEY=
COMPANIES_HOUSE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Path to a user-authorized Telethon session; public channels/messages only.
TELEGRAM_SESSION_PATH=.traceweave/sessions/telegram
LINKEDIN_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v23.0
TRACEWEAVE_INSTAGRAM_OFFICIAL_ENABLED=false

# Optional legacy single OpenAI-compatible endpoint, used only if no mesh route exists.
TRACEWEAVE_API_BASE=
TRACEWEAVE_API_KEY=
TRACEWEAVE_MODEL=

# ----- Local TUI shell -----
# User-triggered only; TraceWeave never grants it to fetched web content/models.
TRACEWEAVE_SHELL_ENABLED=false
TRACEWEAVE_SHELL_TIMEOUT_SECONDS=30
TRACEWEAVE_SHELL_MAX_OUTPUT_CHARS=20000
# Official/commercial providers. They are cataloged automatically but remain blocked while
# TRACEWEAVE_ZERO_COST_ONLY=true. Set that flag false only when you intend to use paid APIs.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# SEC requires a descriptive contact-bearing User-Agent for automated public data access.
SEC_USER_AGENT=
