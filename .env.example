# Storage
TRACEWEAVE_DATA_DIR=.traceweave

# Search: auto | searxng | ddgs
TRACEWEAVE_SEARCH_BACKEND=auto
TRACEWEAVE_SEARXNG_URL=http://127.0.0.1:8080
TRACEWEAVE_SEARCH_TIMEOUT_SECONDS=20

# Fetching
TRACEWEAVE_FETCH_TIMEOUT_SECONDS=20
TRACEWEAVE_FETCH_MAX_BYTES=2000000
TRACEWEAVE_FETCH_CONCURRENCY=3
TRACEWEAVE_USER_AGENT=TraceWeave/0.1

# Optional OpenAI-compatible LLM endpoint.
# Works with providers/routers exposing POST /chat/completions.
# Leave blank to use deterministic planning and source-only output.
TRACEWEAVE_API_BASE=
TRACEWEAVE_API_KEY=
TRACEWEAVE_MODEL=
TRACEWEAVE_LLM_TIMEOUT_SECONDS=60
TRACEWEAVE_LLM_TEMPERATURE=0.2
